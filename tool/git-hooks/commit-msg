#!/bin/sh
# Conventional Commits for 爪记: feat|fix|docs|chore|refactor|test.
# Enable with: git config core.hooksPath tool/git-hooks

message=$(head -n 1 "$1")

if printf '%s' "$message" | grep -Eq '^(Merge |Revert )'; then
  exit 0
fi

if printf '%s' "$message" | grep -Eq '^(feat|fix|docs|chore|refactor|test)(\([a-z0-9._/-]+\))?: .+'; then
  exit 0
fi

echo "提交说明要用 Conventional Commits，例如：feat: 记下开封天数" >&2
echo "类型只使用 feat、fix、docs、chore、refactor、test。" >&2
exit 1
